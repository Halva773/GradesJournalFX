<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gradesfx.controller.MainController"
            stylesheets="@../styles/main.css"
            styleClass="main-container">
    
    <!-- Заголовок -->
    <top>
        <VBox styleClass="header-panel">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📚" styleClass="header-icon"/>
                <VBox spacing="2">
                    <Label text="Журнал оценок студентов" styleClass="header-title"/>
                    <Label text="Управление записями через REST API" styleClass="header-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="progressIndicator" visible="false" 
                                   prefWidth="24" prefHeight="24"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Основное содержимое -->
    <center>
        <HBox spacing="20" styleClass="content-area">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            
            <!-- Левая панель - Таблица -->
            <VBox HBox.hgrow="ALWAYS" spacing="15" styleClass="table-panel">
                <Label text="Список оценок" styleClass="section-title"/>
                
                <TableView fx:id="gradesTable" VBox.vgrow="ALWAYS" styleClass="grades-table">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="60" 
                                     sortable="true" resizable="false"/>
                        <TableColumn fx:id="studentNameColumn" text="Имя студента" 
                                     prefWidth="200" sortable="true"/>
                        <TableColumn fx:id="subjectColumn" text="Предмет" 
                                     prefWidth="180" sortable="true"/>
                        <TableColumn fx:id="gradeColumn" text="Оценка" 
                                     prefWidth="80" sortable="true" resizable="false"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Кнопка обновления под таблицей -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="refreshButton" text="🔄 Обновить" 
                            onAction="#loadGrades" styleClass="secondary-button"/>
                </HBox>
            </VBox>
            
            <!-- Правая панель - Форма -->
            <VBox spacing="20" prefWidth="320" styleClass="form-panel">
                <Label text="Добавить / Редактировать" styleClass="section-title"/>
                
                <!-- Поля формы -->
                <VBox spacing="15" styleClass="form-fields">
                    <!-- Имя студента -->
                    <VBox spacing="5">
                        <Label text="Имя студента" styleClass="field-label"/>
                        <TextField fx:id="studentNameField" 
                                   promptText="Например: Иванов Иван"
                                   styleClass="form-field"/>
                    </VBox>
                    
                    <!-- Предмет -->
                    <VBox spacing="5">
                        <Label text="Предмет" styleClass="field-label"/>
                        <TextField fx:id="subjectField" 
                                   promptText="Например: Математика"
                                   styleClass="form-field"/>
                    </VBox>
                    
                    <!-- Оценка -->
                    <VBox spacing="5">
                        <Label text="Оценка" styleClass="field-label"/>
                        <Spinner fx:id="gradeSpinner" styleClass="grade-spinner" 
                                 prefWidth="150"/>
                    </VBox>
                </VBox>
                
                <!-- Кнопки действий -->
                <VBox spacing="10" styleClass="action-buttons">
                    <Button fx:id="addButton" text="➕ Добавить" 
                            onAction="#addGrade" 
                            styleClass="primary-button" maxWidth="Infinity"/>
                    <Button fx:id="editButton" text="✏️ Редактировать" 
                            onAction="#editGrade" 
                            styleClass="edit-button" maxWidth="Infinity" disable="true"/>
                    <Button fx:id="deleteButton" text="🗑️ Удалить" 
                            onAction="#deleteGrade" 
                            styleClass="delete-button" maxWidth="Infinity" disable="true"/>
                    
                    <Separator/>
                    
                    <Button fx:id="clearButton" text="✖ Очистить форму" 
                            onAction="#clearForm" 
                            styleClass="secondary-button" maxWidth="Infinity"/>
                </VBox>
                
                <!-- Подсказка -->
                <VBox styleClass="hint-box" spacing="5">
                    <Label text="💡 Подсказка" styleClass="hint-title"/>
                    <Label text="Выберите запись в таблице для редактирования или удаления" 
                           styleClass="hint-text" wrapText="true"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
    
    <!-- Нижняя панель - Статус -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="10" right="30" bottom="10" left="30"/>
            </padding>
            <Label fx:id="statusLabel" text="Готово" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="REST API: localhost:8080" styleClass="status-info"/>
        </HBox>
    </bottom>
</BorderPane>


